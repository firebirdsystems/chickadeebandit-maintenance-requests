{
  "id": "maintenance-requests",
  "contexts": ["household", "shared_space"],
  "name": "Maintenance Requests",
  "version": "1.0.0",
  "description": "Submit and track facility maintenance requests. Members report issues; leadership triages, assigns, and resolves them.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["maintenance", "requests", "facilities", "org", "hoa"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "row_policies": {
    "requests": {
      "kind": "owner_only",
      "member_column": "submitted_by",
      "adults_bypass": true,
      "member_can_update": false
    },
    "comments": {
      "kind": "owner_only",
      "member_column": "author_id",
      "adults_bypass": true,
      "member_can_update": false,
      "endpoint_writes_only": true
    }
  },
  "append_only_records": {
    "comments": {
      "table": "comments",
      "parent_table": "requests",
      "parent_fk_column": "request_id",
      "parent_status_column": "status",
      "parent_blocked_status_values": [],
      "allowed_columns": ["request_id", "body"],
      "writer_column": "author_id",
      "created_at_column": "created_at",
      "max_text_lengths": {
        "request_id": 120,
        "body": 2000
      }
    }
  },
  "nav": {
    "label": "Maintenance"
  },
  "icon": "🔨",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["open_requests", "all_requests"]
  }
}
