{
  "id": "maintenance-requests",
  "contexts": ["household", "shared_space"],
  "name": "Maintenance Requests",
  "version": "1.0.1",
  "description": "Submit and track facility maintenance requests. Members report issues; leadership triages, assigns, and resolves them.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["maintenance", "requests", "facilities", "org", "hoa"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "requests": {"sql": "SELECT * FROM app_maintenance_requests__requests ORDER BY CASE priority WHEN 'urgent' THEN 0 WHEN 'high' THEN 1 WHEN 'medium' THEN 2 ELSE 3 END, created_at DESC"}
  },
  "automation_actions": {
    "file_request": {
      "title": "File a maintenance request",
      "description": "Open a maintenance request when another app's event fires — a failed inspection, a reported problem, an overdue service.",
      "params": {
        "submitted_by": {
          "type": "member",
          "label": "Submitted by",
          "required": true
        },
        "title": {
          "type": "text",
          "label": "What needs attention",
          "required": true
        },
        "description": {
          "type": "text",
          "label": "Details",
          "default": ""
        },
        "priority": {
          "type": "text",
          "label": "Priority",
          "default": "medium",
          "options": ["low", "medium", "high"]
        }
      },
      "dedupe": {
        "table": "requests",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "requests",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "description": ":description",
            "priority": ":priority",
            "submitted_by": ":submitted_by",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "db_plaintext_columns": ["assigned_to", "priority"],
  "row_policies": {
    "requests": {
      "kind": "owner_only",
      "member_column": "submitted_by",
      "adults_bypass": true,
      "member_can_update": false
    },
    "comments": {
      "kind": "owner_only",
      "member_column": "author_id",
      "adults_bypass": true,
      "member_can_update": false,
      "endpoint_writes_only": true
    }
  },
  "append_only_records": {
    "comments": {
      "table": "comments",
      "parent_table": "requests",
      "parent_fk_column": "request_id",
      "parent_status_column": "status",
      "parent_blocked_status_values": [],
      "allowed_columns": ["request_id", "body"],
      "writer_column": "author_id",
      "created_at_column": "created_at",
      "max_text_lengths": {
        "request_id": 120,
        "body": 2000
      }
    }
  },
  "member_references": {
    "requests": [
      { "column": "submitted_by", "on_removed": "keep" },
      { "column": "assigned_to", "on_removed": "null" }
    ],
    "comments": { "column": "author_id", "on_removed": "keep" }
  },
  "delete_cascades": {
    "requests": [
      { "table": "comments", "foreign_key": "request_id" }
    ]
  },
  "resource_limits": { "max_db_bytes": 52428800 },
  "publishes": ["maintenance_request.filed", "maintenance_request.resolved"],
  "publish_acls": {"maintenance_request.filed": {"require_role": "member"}, "maintenance_request.resolved": {"require_role": "adult"}},
  "glance": {"source": {"kind": "sql", "query": "SELECT COUNT(*) AS n FROM app_maintenance_requests__requests WHERE status = 'open' LIMIT 1"}, "display": {"template": "badge", "count": "n", "label": "open requests", "severity": "warn"}},
  "nav": {
    "label": "Maintenance"
  },
  "icon": "🔨",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["open_requests", "all_requests"]
  }
}
